{
  "name": "toledo-plus-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Toledo+ API (Cloudflare Worker): anonymous usage ping, feedback, latest version.",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
