{
  "manifest_version": 3,
  "name": "Toledo+",
  "short_name": "Toledo+",
  "version": "0.2.1",
  "description": "Een rustigere, duidelijkere Toledo: startpagina met deadlines en nieuwe items, en een overzichtelijke vakpagina.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://toledo.kuleuven.be/*", "https://ultra.edu.kuleuven.cloud/*"],
  "content_scripts": [
    {
      "matches": ["https://toledo.kuleuven.be/portal/*"],
      "js": ["content.js"],
      "css": ["page.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://ultra.edu.kuleuven.cloud/ultra/*"],
      "js": ["course.js"],
      "css": ["page.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["ui.css"], "matches": ["https://toledo.kuleuven.be/*", "https://ultra.edu.kuleuven.cloud/*"] }
  ]
}
