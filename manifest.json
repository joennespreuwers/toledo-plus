{
  "manifest_version": 3,
  "name": "Toledo+",
  "short_name": "Toledo+",
  "version": "1.5.0",
  "description": "Een rustige, overzichtelijke Toledo: deadlines, nieuwe items, vakken, agenda en KU Loket in één app, volgens Apple's ontwerprichtlijnen.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://toledo.kuleuven.be/*",
    "https://ultra.edu.kuleuven.cloud/*",
    "https://webwsp.aps.kuleuven.be/*",
    "https://cloud.timeedit.net/*",
    "https://api.toledoplus.be/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://toledo.kuleuven.be/portal/*"
      ],
      "js": [
        "src/core/util.js",
        "src/core/i18n.js",
        "src/i18n/core.js",
        "src/i18n/overview.js",
        "src/i18n/deadlines.js",
        "src/i18n/announcements.js",
        "src/i18n/courses.js",
        "src/i18n/course.js",
        "src/i18n/settings.js",
        "src/i18n/agenda.js",
        "src/i18n/kuloket.js",
        "src/i18n/palette.js",
        "src/i18n/feedback.js",
        "src/i18n/fulltext.js",
        "src/core/settings.js",
        "src/core/net.js",
        "src/core/data.js",
        "src/core/kuloket.js",
        "src/core/telemetry.js",
        "src/core/index.js",
        "src/core/fulltext-engine.js",
        "src/core/fulltext.js",
        "src/core/ui.js",
        "src/core/motion.js",
        "src/core/shell.js",
        "src/core/palette.js",
        "src/core/feedback.js",
        "src/views/overview.js",
        "src/views/deadlines.js",
        "src/views/announcements.js",
        "src/views/courses.js",
        "src/views/course.js",
        "src/views/settings.js",
        "src/views/agenda.js",
        "src/views/kuloket.js",
        "src/boot.js"
      ],
      "css": [
        "page.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ultra.edu.kuleuven.cloud/ultra/*"
      ],
      "js": [
        "src/core/util.js",
        "src/core/i18n.js",
        "src/i18n/core.js",
        "src/i18n/overview.js",
        "src/i18n/deadlines.js",
        "src/i18n/announcements.js",
        "src/i18n/courses.js",
        "src/i18n/course.js",
        "src/i18n/settings.js",
        "src/i18n/agenda.js",
        "src/i18n/kuloket.js",
        "src/i18n/palette.js",
        "src/i18n/feedback.js",
        "src/i18n/fulltext.js",
        "src/core/settings.js",
        "src/core/net.js",
        "src/core/data.js",
        "src/core/kuloket.js",
        "src/core/telemetry.js",
        "src/core/index.js",
        "src/core/fulltext-engine.js",
        "src/core/fulltext.js",
        "src/core/ui.js",
        "src/core/motion.js",
        "src/core/shell.js",
        "src/core/palette.js",
        "src/core/feedback.js",
        "src/views/overview.js",
        "src/views/deadlines.js",
        "src/views/announcements.js",
        "src/views/courses.js",
        "src/views/course.js",
        "src/views/settings.js",
        "src/views/agenda.js",
        "src/views/kuloket.js",
        "src/boot.js"
      ],
      "css": [
        "page.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://toledo.kuleuven.be/",
        "https://toledo.kuleuven.be/?*",
        "https://toledo.kuleuven.be/index.html*"
      ],
      "js": [
        "src/landing.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui.css",
        "src/views/*.css",
        "fonts/*.woff2",
        "fonts/OFL-Inter.txt",
        "src/core/fulltext-host.html",
        "src/core/fulltext-host.mjs",
        "src/core/fulltext-worker.mjs",
        "src/core/fulltext-engine.js",
        "src/vendor/pdfjs/*.mjs",
        "src/vendor/pdfjs/LICENSE"
      ],
      "matches": [
        "https://toledo.kuleuven.be/*",
        "https://ultra.edu.kuleuven.cloud/*"
      ]
    }
  ]
}
